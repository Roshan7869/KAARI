{
  "name": "kaari-marketplace",
  "description": "Kaari Marketplace - A handmade crochet products e-commerce platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' npx next dev -p 3000",
    "build": "npx next build",
    "start": "npx next start -p 3000",
    "lint": "npx next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true npx next build",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "email:preview": "email dev --port 3001 --dir ./emails",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf .next dist node_modules",
    "seed:catalog": "node scripts/upload-catalog.js",
    "seed:catalog:dry": "DRY_RUN=true node scripts/upload-catalog.js",
    "prebuild": "npm run lint"
  },
