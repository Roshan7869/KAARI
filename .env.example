# =============================================
# Kaari Marketplace — Environment Variables
# =============================================
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local or any file containing real secrets
# =============================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ----
# Database & Auth connection
# Get from: app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=YOUR_NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID
# Public/Anon key — safe to expose (has limited RLS permissions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SERVER-SIDE ONLY — full admin access (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Cashfree Payment Gateway ----
# Get from: merchant.cashfree.com → Developers → API Keys
# SERVER-SIDE ONLY — never prefix these with NEXT_PUBLIC_
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_WEBHOOK_SECRET=YOUR_CASHFREE_WEBHOOK_SECRET
CASHFREE_TEST_MODE=true

# Controls sandbox vs production for UPI SDK (safe for client)
NEXT_PUBLIC_CASHFREE_MODE=sandbox
# For production deploy: NEXT_PUBLIC_CASHFREE_MODE=production

# ---- Cloudinary (Product Image Uploads) ----
# Get from: console.cloudinary.com → Settings → Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=YOUR_NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
# SERVER-SIDE ONLY secret — never prefix with NEXT_PUBLIC_
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ---- Upstash Redis (server-side rate limiting) ----
# Get from: console.upstash.com → your DB → REST API
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_TOKEN

# ---- Email (Resend) ----
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATIONS_FROM_EMAIL=YOUR_NOTIFICATIONS_FROM_EMAIL

# ---- Admin Features (Review Management) ----
# Dashboard: /admin/reviews (requires admin role in user_roles table)
# Review Approval: Pending → Approve/Reject → Published
# Visibility Control: Toggle reviews visible/hidden anytime
# Search & Filter: By product, customer, rating, status, date
# Audit Trail: Track all admin changes with admin ID + timestamp
# Storage: customization-uploads bucket for inspiration images

# ---- Social Media / Instagram (optional) ----
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ---- Local Development ----
NX_DAEMON=false
